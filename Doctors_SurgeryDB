--Query 4: Missed Appointments Rate. 
SELECT 
    (SELECT COUNT(*) FROM Appointments) AS TotalBooked, 
    (SELECT COUNT(*)
    FROM Appointments a   
    LEFT JOIN Diagnosis d ON a.Appointment_ID = d.Appointment_ID
    WHERE d.Appointment_ID IS NULL) AS Missed,
    CAST(
        (SELECT COUNT(*)
        FROM Appointments a  
        LEFT JOIN Diagnosis d ON a.Appointment_ID = d.Appointment_ID
        WHERE d.Appointment_ID IS NULL) * 100.0/
        (SELECT COUNT(*) FROM Appointments) 
    AS DECIMAL(5,2)) AS MissedPercentage;

    